{
  "name": "set_sliders",
  "description": "Set CalibRaw sliders to new absolute values. Sliders left out keep their current values.",
  "parameters": {
    "type": "object",
    "properties": {
      "exposure": { "type": "number", "minimum": -5, "maximum": 5, "description": "Overall brightness in stops." },
      "contrast": { "type": "number", "minimum": -100, "maximum": 100 },
      "highlights": { "type": "number", "minimum": -100, "maximum": 100, "description": "Negative recovers bright areas." },
      "shadows": { "type": "number", "minimum": -100, "maximum": 100, "description": "Positive lifts dark areas." },
      "whites": { "type": "number", "minimum": -100, "maximum": 100, "description": "Sets the brightest point." },
      "blacks": { "type": "number", "minimum": -100, "maximum": 100, "description": "Sets the darkest point." },
      "warmth": { "type": "number", "minimum": -100, "maximum": 100, "description": "Positive is warmer, negative cooler." },
      "vibrance": { "type": "number", "minimum": -100, "maximum": 100, "description": "Boosts muted colours more than saturated ones." },
      "saturation": { "type": "number", "minimum": -100, "maximum": 100 },
      "texture": { "type": "number", "minimum": -100, "maximum": 100, "description": "Fine detail." },
      "clarity": { "type": "number", "minimum": -100, "maximum": 100, "description": "Midtone contrast." },
      "dehaze": { "type": "number", "minimum": -100, "maximum": 100 }
    },
    "additionalProperties": false
  }
}
