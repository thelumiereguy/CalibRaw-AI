    {"id": "more-contrast", "prompts": ["Add more contrast"], "photos": ["mountains", "selfie", "helicopter"],
     "set": ["contrast+|whites+|blacks-|clarity+|set_tone_curve.rgb!"], "img": ["spread up"], "allow": ["crush"]},
    {"id": "flatter", "prompts": ["Make it flatter and softer"], "photos": ["mountains", "selfie", "helicopter"],
     "set": ["contrast-|highlights-|shadows+|clarity-|set_tone_curve.rgb!"], "img": ["spread down"]},
    {"id": "lift-shadows", "prompts": ["Lift the shadows"], "photos": ["concert", "selfie", "helicopter"],
     "set": ["shadows+|blacks+"], "img": ["p10 up"]},
